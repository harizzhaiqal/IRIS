# Supabase project URL. Dashboard → Project Settings → Data API → Project URL,
# or https://<project-ref>.supabase.co using the ref from the dashboard address.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key — Dashboard → Project Settings → API Keys. Safe in the
# browser; RLS constrains what it can reach. Older projects show this as the
# "anon" key, a long JWT starting eyJ. Either format works.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-publishable-key

# Secret key — same page. Bypasses RLS entirely, so it is server-side only and
# must never be prefixed with NEXT_PUBLIC_. Older projects call this the
# "service_role" key. Rotate it if it is ever pasted somewhere it should not be.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-secret-key

# Running the local Supabase stack instead? Use the URL and keys that
# `npx supabase start` prints; that stack still issues the legacy JWT keys.
