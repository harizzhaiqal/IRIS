# Local-only values for `supabase functions serve --env-file`.
# Configure the same names under Edge Function Secrets in hosted Supabase.
RESEND_API_KEY=re_your-api-key
REMINDER_FROM_EMAIL=IRIS HR <reminders@updates.your-domain.com>
IRIS_APP_URL=http://localhost:3000
REMINDER_CRON_SECRET=replace-with-a-long-random-secret
